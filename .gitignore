# Source datasets are never redistributed; obtain them per README.md
/data/*
!/data/.gitkeep
!/data/README.md

# Production run outputs (root-anchored, so reference_outputs/results/ is kept)
/production_runs/
/results/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Environments
.venv/
venv/
env/

# Logs and temporary files
*.log
/logs/
/tmp/
/temp/
*.tmp

# Secrets and local configuration
.env
.env.*
*.pem
*.key
secrets.*
credentials.*

# OS and IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
